# Optional OpenAI API key
OPENAI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# INR conversion rate
INR_EXCHANGE_RATE=88.0

# Semantic cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL=3600

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cost log
COST_LOG_FILE=llm_cost_log.csv